BLADEIA_IMAGE_REPOSITORY=ghcr.io/ex1t-s/botlummine-backend
BLADEIA_IMAGE_TAG=replace-with-a-40-character-git-sha
BLADEIA_POSTGRES_DB=bladeia
BLADEIA_POSTGRES_USER=bladeia
BLADEIA_POSTGRES_PASSWORD=replace-with-a-random-secret

NODE_ENV=production
PORT=8080
DATABASE_URL=postgresql://bladeia:replace-with-a-random-secret@db:5432/bladeia?schema=public&connection_limit=3&pool_timeout=10
BACKEND_PUBLIC_URL=https://api.bladeia.com
FRONTEND_URL=https://www.bladeia.com
FRONTEND_URL_PROD=https://www.bladeia.com
CAMPAIGN_DISPATCHER_ENABLED=false
HEALTHCHECK_DB=true

OBJECT_STORAGE_MODE=r2
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-app-access-key
R2_SECRET_ACCESS_KEY=replace-with-app-secret-key
R2_BACKUP_ACCESS_KEY_ID=replace-with-backup-access-key
R2_BACKUP_SECRET_ACCESS_KEY=replace-with-backup-secret-key
R2_PRIVATE_BUCKET=bladeia-private-prod
R2_PUBLIC_BUCKET=bladeia-public-prod
R2_PUBLIC_BASE_URL=https://assets.bladeia.com

# Opcional: webhook compatible con un cuerpo JSON {"text":"..."}.
ALERT_WEBHOOK_URL=
